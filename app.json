{
  "expo": {
    "name": "Shilp",
    "slug": "shilpApp",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/splash-icon.jpeg",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meghana1904.shilpApp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/splash-icon.jpeg",
        "backgroundImage": "./assets/splash-icon.jpeg",
        "monochromeImage": "./assets/splash-icon.jpeg"
      },
      "package": "com.meghana1904.shilpApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.jpeg",
    "imageWidth": 1,
          "resizeMode": "cover",
          "backgroundColor": "#E6F4FE",
          "dark": {
            "image": "./assets/splash-icon.jpeg",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ],
      "expo-sharing",
      "expo-asset"
    ],
    "scheme": "shilpapp",
    "extra": {
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "dark"
      },
      "eas": {
        "projectId": "82a61e95-46c2-44fe-82ad-80c3134e943f"
      }
    }
  }
}
